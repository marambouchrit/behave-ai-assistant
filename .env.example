# Toutes les variables sont lues par config.py (pydantic-settings).
# Les valeurs indiquées après "=" sont les valeurs par défaut quand elles existent.

# ── Auth & Base de données (obligatoires pour le backend) ─────────────────
# Les comptes (dont le premier admin) se créent avec : python -m backend.manage
JWT_SECRET_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/behave_db
JWT_EXPIRE_MINUTES=480
# Tentatives de connexion autorisées par adresse IP
LOGIN_RATE_LIMIT=5/minute

# ── API ────────────────────────────────────────────────────────────────────
# Origines du frontend autorisées (liste JSON)
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_SIZE_MB=20

# ── Groq API ───────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL_TEXT=openai/gpt-oss-20b
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
# low | medium | high — tokens de raisonnement décomptés de GROQ_MAX_TOKENS
GROQ_REASONING_EFFORT=low

# ── RAG ────────────────────────────────────────────────────────────────────
# Chunks transmis au LLM / candidats du premier étage soumis au reranker
RAG_K=4
RAG_CANDIDATES_K=20
RAG_MAX_HISTORY_TURNS=10
RAG_HISTORY_TOKEN_BUDGET=6000

# ── Reranking (second étage) ───────────────────────────────────────────────
# Modèle et seuil calibrés par : python -m evaluation.run_eval
RERANKER_ENABLED=true
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Seuil de pertinence quand le reranker est actif (score du cross-encoder, [0, 1])
# RAG_MIN_RERANK_SCORE=0.75
# Seuil de pertinence quand le reranker est désactivé (similarité cosinus brute,
# dépend du modèle d'embedding : 0.81 calibré pour multilingual-e5-base)
RAG_MIN_COSINE_SIMILARITY=0.81

# ── Embeddings & chunking ──────────────────────────────────────────────────
# Changer de modèle impose : python -m ingestion.run_indexation --reset
# EMBEDDING_MODEL=intfloat/multilingual-e5-base
# EMBEDDING_QUERY_PREFIX="query: "
# EMBEDDING_PASSAGE_PREFIX="passage: "
# CHUNK_SIZE_CHARS=1200
# CHUNK_OVERLAP_CHARS=150

# ── ChromaDB & documents (défauts : dossiers/fichiers sous data/) ─────────
# CHROMA_DB_DIR=/absolute/path/to/data/chroma_db
# DOCUMENTS_DIR=/absolute/path/to/data/documents
# UPLOADED_DOCS_DIR=/absolute/path/to/data/uploaded_docs
# MANIFEST_PATH=/absolute/path/to/data/manifest.yaml
